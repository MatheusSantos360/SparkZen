{
  "name": "sparkzen",
  "version": "0.0.3",
  "license": "MIT",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --out-dir dist",
    "dev": "tsup src/index.ts --format esm --dts --watch --out-dir dist",
    "lint": "tsc --noEmit",
    "test": "vitest",
    "release": "pnpm run build && changeset publish"
  },
  "dependencies": {
    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@types/node": "^24.9.2",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3",
    "vitest": "^4.0.6"
  }
}
